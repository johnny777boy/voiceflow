    <key>NSMicrophoneUsageDescription</key>
    <string>VoiceFlow records audio while you hold the dictation hotkey so it can transcribe your speech.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>VoiceFlow uses on-device speech recognition to turn your dictation into text.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Personal use.</string>
</dict>
